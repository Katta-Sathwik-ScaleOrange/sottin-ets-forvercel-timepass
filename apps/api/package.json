    "migrate:002": "node scripts/run-migration.js migrations/002_osm_features.sql",
    "migrate:003": "node scripts/run-migration.js migrations/003_schema_fixes.sql",
    "migrate:004": "node scripts/run-migration.js migrations/004_comprehensive_fix.sql",
    "migrate:all": "node scripts/migrate-all.js",
    "seed": "node scripts/seed.js",
    "setup": "node scripts/migrate-all.js && node scripts/seed.js",
    "verify": "node scripts/verify-fixes.js",
    "make:admin": "node scripts/make-admin.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.19.0",
    "google-auth-library": "^9.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.0",
    "razorpay": "^2.9.0",
    "redis": "^4.6.0",
    "typesense": "^1.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
